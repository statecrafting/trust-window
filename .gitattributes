# Enforce LF line endings for all text files in this repository.
* text=auto eol=lf

# --- Source code ---
*.rs        text eol=lf

# --- Config / markup ---
*.json      text eol=lf
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# --- Docs ---
*.md        text eol=lf
*.txt       text eol=lf

# --- Shell / config ---
*.sh        text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# --- Binary: never touch line endings ---
*.png       binary
*.jpg       binary
*.gif       binary
*.pdf       binary
*.gz        binary

# --- Derived-artifact merge driver (forward-looking) ---
# When this repo's spec-spine self-governance lands (committed .derived/ shards
# plus .githooks/, deferred to a later session), two branches that both
# regenerated the per-spec / per-package JSON shards would conflict textually.
# The `trust-window-derived-regen` driver regenerates them from the merged tree
# instead of leaving conflict markers. Opt-in: register per-clone with
# `./.githooks/enable-merge-driver.sh`. Unregistered (the case today), git falls
# back to the default text merge. build-meta.json is gitignored.
.derived/**/*.json merge=trust-window-derived-regen
